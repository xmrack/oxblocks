# Hardened systemd unit for oxblocks.
#
# The explorer holds no keys, opens no database and writes nothing, so almost
# every capability can be removed. What remains is: make outbound TCP to the
# daemon, and accept inbound TCP. Anything beyond that is a bug, and this unit
# makes it a fatal one rather than a silent one.
#
#   install -m644 deploy/oxblocks.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now oxblocks

[Unit]
Description=oxblocks Monero block explorer
Documentation=https://github.com/xmrack/oxblocks
# Wants= rather than Requires=: the explorer starts and serves a "daemon
# unavailable" page if monerod is down, which is more useful than refusing to
# start at all.
Wants=network-online.target monerod.service
After=network-online.target monerod.service

[Service]
Type=exec
ExecStart=/usr/local/bin/oxblocks --bind 127.0.0.1:8081 --daemon-url http://127.0.0.1:18081
Restart=on-failure
RestartSec=5s

# No persistent identity, no home, nothing to compromise between restarts.
DynamicUser=yes

# --- filesystem -----------------------------------------------------------
# There is nothing to write. The stylesheet is compiled into the binary and
# the cache is in memory, so the whole filesystem can be read-only.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=
UMask=0077

# --- privileges -----------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
PrivateIPC=yes
# Sees no other user: every uid but its own and root's maps to nobody.
PrivateUsers=yes

# --- kernel ---------------------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes

# --- execution ------------------------------------------------------------
# Rust emits no runtime-generated code, so W^X can be enforced outright. This
# removes a large part of what an exploit would need in order to be useful.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @debug @mount @swap @reboot @raw-io @cpu-emulation

# --- network --------------------------------------------------------------
# TCP only. No unix sockets, no netlink, no packet sockets.
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
# If the daemon or the reverse proxy is not on loopback, widen the two lines
# above to exactly those addresses -- not to `any`.
# Listens on the port in --bind and no other. Change both together.
SocketBindDeny=any
SocketBindAllow=tcp:8081

# --- limits ---------------------------------------------------------------
# The caches are bounded, so a figure that keeps rising with an idle explorer
# means a leak: fail loudly rather than take the host down.
#
# The fan-out endpoints -- /api/blocks, /api/transactions,
# /api/transactions/recent -- fetch every transaction in their window before
# summarising any of it. Measured against a mainnet daemon: one /api/blocks
# request spanning the full 100 blocks holds about 40 MiB while it runs. All
# such ranges together hold at most 48 MiB of chain data (RANGE_KIB in
# explorer-core), which is roughly 160 MiB held as hex and JSON. One range
# may hold half of that at most, and a wider one is refused; a range that
# would take more than is left waits up to 5 seconds for others to finish,
# and is then answered as busy. Single blocks' pages hold another 32 MiB of
# chain data at most (BLOCK_KIB), roughly 110 MiB. With the caches' 244 MiB
# that leaves about half of the 1 GiB here for what is outside those budgets:
# the mempool, fetched whole, up to --max-response-mib as it arrives and
# several times that decoded; the last /api/transactions/recent answer, kept
# written out until a block arrives or the pool changes; and a rendered
# response waiting for a slow client to read it, since both limits are given
# back when the response is handed over. Rate limiting and buffering at the
# reverse proxy are the other half of this.
#
# --max-inflight-rpc is the separate ceiling on calls reaching monerod. Lower it
# if the daemon is shared with a wallet or another consumer; it bounds load on
# the node, not memory here. Keep it under monerod's
# --rpc-max-connections-per-private-ip (25), or -per-public-ip (3) for a
# daemon reached over a public address, past which monerod drops connections.
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
